        </li>
      </ul>
    </div>
  </div>
</nav>

<!-- JavaScript to Automate Active Link Coloring -->
<script>
  document.addEventListener("DOMContentLoaded", function () {
    // Get the current URL path (e.g., "/" or "/pricing")
    const currentPath = window.location.pathname;
    
    // Select all links inside our navbar
    const navLinks = document.querySelectorAll(".navbar-nav .nav-link");
    
    navLinks.forEach(link => {
      // Get the path the link points to
      const linkPath = link.getAttribute("href");
      
      // Match exact path, or match root "/" accurately
      if (currentPath === linkPath || (currentPath === "" && linkPath === "/")) {
        link.classList.remove("text-white-50");
        link.classList.add("active", "fw-bold");
        link.style.setProperty("color", "#ff4a3d", "important");
      }
    });
  });
</script>

<style>
  /* Hover effects for unselected links */
  .navbar-nav .nav-link {
    transition: color 0.2s ease;
  }
  .navbar-nav .nav-link:hover {
    color: #ff4a3d !important;
  }
</style>







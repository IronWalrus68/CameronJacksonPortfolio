<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%- title %></title>
    <link rel="icon" href="walrus2.svg" type="image/x-icon">
    
    <!-- Bootstrap 5.3.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    
    <!-- Google reCAPTCHA -->
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>

    <style>
        body {
            background-color: #0f111a;
            color: #e2e8f0;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        main {
            flex: 1 0 auto;
        }
        /* Navbar Hover & Active Transitions */
        .navbar-nav .nav-link {
            transition: color 0.2s ease;
        }
        .navbar-nav .nav-link:hover {
            color: #ff4a3d !important;
        }
        /* Footer Styling */
        .footer-legal {
            background-color: #0b0c12;
            border-top: 1px solid #222533;
            padding: 3rem 0;
            margin-top: auto;
        }
        .footer-link {
            color: #94a3b8;
            text-decoration: none;
            transition: color 0.2s ease;
        }
        .footer-link:hover {
            color: #ff4a3d;
        }
        .text-muted-dark {
            color: #94a3b8;
        }
    </style>
</head>
<body>

<!-- Section: Universal Navigation Bar -->
<nav class="navbar navbar-expand-lg navbar-dark sticky-top border-bottom border-secondary" style="background-color: #0b0c12 !important; border-color: #222533 !important;">
  <div class="container">
    <a class="navbar-brand d-flex align-items-center fw-bold text-white" href="/">
      ⚡ <span class="ms-2">Cam<span style="color: #ff4a3d;">J Pat Testing</span></span>
    </a>
    
    <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    
    <div class="collapse navbar-collapse" id="mainNavbar">
      <ul class="navbar-nav ms-auto mb-2 mb-lg-0 fw-medium">
        <li class="nav-item px-2"><a class="nav-link text-white-50" href="/">Home</a></li>
        <li class="nav-item px-2"><a class="nav-link text-white-50" href="/pat-info">PAT Info</a></li>
        <li class="nav-item px-2"><a class="nav-link text-white-50" href="/pricing">Pricing</a></li>
        <li class="nav-item px-2"><a class="nav-link text-white-50" href="/contact">Contact</a></li>
      </ul>
    </div>
  </div>
</nav>

<!-- Main Page Content Injection -->
<main>
    <%- body %>
</main>

<!-- Section: Universal Footer -->
<footer class="footer-legal text-center">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-md-6 text-md-start mb-3 mb-md-0">
        <span class="fw-bold text-white">⚡ Cam<span style="color: #ff4a3d;">J Pat Testing</span></span>
        <p class="small text-muted-dark mb-0 mt-1">© 2026 CamJ PAT Testing. All rights reserved.</p>
      </div>
      <div class="col-md-6 text-md-end">
        <ul class="list-inline mb-0 small">
          <li class="list-inline-item px-2"><a href="/" class="footer-link">Home</a></li>
          <li class="list-inline-item px-2"><a href="/pat-info" class="footer-link">PAT Info</a></li>
          <li class="list-inline-item px-2"><a href="/pricing" class="footer-link">Pricing</a></li>
          <li class="list-inline-item px-2"><a href="/contact" class="footer-link">Contact</a></li>
          <li class="list-inline-item px-2"><a href="/terms" class="footer-link">Terms &amp; Disclaimers</a></li>
        </ul>
      </div>
    </div>
  </div>
</footer>

<!-- Bootstrap 5.3.3 JS Bundle -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>

<!-- Script: Active Route Highlight Manager -->
<script>
  document.addEventListener("DOMContentLoaded", function () {
    const currentPath = window.location.pathname;
    const allLinks = document.querySelectorAll(".navbar-nav .nav-link, .footer-link");
    
    allLinks.forEach(link => {
      const linkPath = link.getAttribute("href");
      
      if (currentPath === linkPath || (currentPath === "" && linkPath === "/")) {
        link.classList.remove("text-white-50", "text-muted-dark");
        link.classList.add("active", "fw-bold");
        link.style.setProperty("color", "#ff4a3d", "important");
        
        if (link.classList.contains("footer-link") && linkPath === "/terms") {
          link.style.borderBottom = "1px solid #bd2c1d";
        }
      }
    });
  });
</script>
</body>
</html>

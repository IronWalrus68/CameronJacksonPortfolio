<% layout('layouts/boilerplate') %>

<style>
  .fail-card {
    background: #161925;
    border: 1px solid #222533;
    border-top: 4px solid #bd2c1d; /* Red failure top-accent */
    border-radius: 1.25rem;
    padding: 3.5rem 2.5rem;
  }
  .icon-fail {
    font-size: 3.5rem;
    color: #bd2c1d;
    background-color: #0b0c12;
    width: 90px;
    height: 90px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 1px solid #222533;
    margin: 0 auto 1.5rem auto;
  }
  .text-muted-dark {
    color: #94a3b8;
  }
  .btn-red {
    background-color: #bd2c1d;
    color: white;
    font-weight: 600;
    padding: 0.75rem 1.75rem;
    border-radius: 0.75rem;
    transition: all 0.2s ease;
  }
  .btn-red:hover {
    background-color: #ff4a3d;
    color: white;
    box-shadow: 0 4px 15px rgba(255, 74, 61, 0.4);
  }
</style>

<main class="container my-5 text-center">
  <div class="row">
    <div class="col-lg-6 mx-auto">
      <div class="fail-card shadow-sm">
        <div class="icon-fail">⚠</div>
        <h1 class="h2 fw-bold text-white mb-3">Submission Failed</h1>
        <p class="lead text-white-50 fs-5 mb-3">An internal processing error occurred.</p>
        <p class="text-muted-dark small mb-5">
          We encountered an issue routing your data through the email gateway. Your request was not delivered. Please try again or contact us directly via phone to secure your slot.
        </p>
        <div class="d-flex flex-column gap-2">
          <a href="tel:01622278135" class="btn btn-red py-2.5">
            📞 Call Now: 01622 278 135
          </a>
          <a href="/contact" class="btn btn-link text-white-50 small mt-2">
            Try the form again
          </a>
        </div>
      </div>
    </div>
  </div>
</main>

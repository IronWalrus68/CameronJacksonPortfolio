<% layout('layouts/boilerplate') %>

<style>
  body {
    background-color: #0f111a;
    color: #e2e8f0;
    scroll-behavior: smooth;
  }

  /* HERO UPGRADE */
  .hero {
    min-height: 85vh;
    background: linear-gradient(135deg, #161925 0%, #0b0c12 100%);
    display: flex;
    align-items: center;
    position: relative;
    padding: 6rem 0;
    border-bottom: 1px solid #222533;
  }

  .hero h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    color: #fff;
  }

  .hero-accent {
    color: #ff4a3d;
  }

  /* Badge Floating Layout */
  .badge-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .qualification-badge-img {
    width: 100%;
    max-width: 260px;
    height: auto;
    filter: drop-shadow(0 10px 20px rgba(0,0,0,0.5));
    transition: transform 0.3s ease;
  }

  .qualification-badge-img:hover {
    transform: scale(1.03);
  }

  /* Structured Content Rows */
  section {
    padding: 6rem 0;
  }

  .bg-alt {
    background-color: #161925;
    border-top: 1px solid #222533;
    border-bottom: 1px solid #222533;
  }

  .image-container {
    width: 100%;
    height: 360px;
    overflow: hidden;
    border-radius: 1.25rem;
    box-shadow: 0 15px 35px rgba(0,0,0,0.6);
    border: 1px solid #222533;
  }

  .image-container img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .text-muted-dark {
    color: #94a3b8;
  }

  /* Custom Action Buttons */
  .btn-red {
    background-color: #bd2c1d;
    color: white;
    font-weight: 600;
    padding: 0.75rem 1.75rem;
    border-radius: 0.75rem;
    transition: all 0.2s ease;
  }

  .btn-red:hover {
    background-color: #ff4a3d;
    color: white;
    box-shadow: 0 4px 15px rgba(255, 74, 61, 0.4);
  }

  .btn-outline-custom {
    border: 1px solid #222533;
    color: #e2e8f0;
    background-color: #0b0c12;
    font-weight: 600;
    padding: 0.75rem 1.75rem;
    border-radius: 0.75rem;
    transition: all 0.2s ease;
  }

  .btn-outline-custom:hover {
    border-color: #ff4a3d;
    color: #fff;
  }

  /* Floating Action Button */
  .contact-fab {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 1000;
  }

  .contact-fab a {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    background-color: #bd2c1d;
    border: none;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.6);
    transition: all 0.2s ease;
  }

  .contact-fab a:hover {
    background-color: #ff4a3d;
    transform: scale(1.05);
  }
</style>

<!-- HERO LAYOUT -->
<div class="hero">
  <div class="container">
    <div class="row align-items-center g-5">
      <div class="col-lg-7 text-center text-lg-start">
        <h1 class="fw-bold mb-3">Cam<span class="hero-accent">J Pat Testing</span></h1>
        <p class="lead text-white-50 fs-4 mb-4">Reliable, Honest, Fair.</p>
        <p class="text-muted-dark mb-4 fs-5">
          Helping businesses, landlords, and organizations throughout Maidstone and Kent meet their statutory electrical safety requirements with precision, transparent metering, and infallible compliance reports.
        </p>
        <div class="d-flex flex-wrap justify-content-center justify-content-lg-start gap-3">
          <a href="/pricing" class="btn btn-red shadow-sm">💰 View Rates &amp; Estimate Cost</a>
          <a href="/contact" class="btn btn-outline-custom">📅 Request Appointment</a>
        </div>
      </div>
      <div class="col-lg-5 text-center badge-wrapper">
        <a href="https://digitalcredentials.cityandguilds.com/884ad82f-6216-4f24-b324-4a1b8c1dedd6#acc.cP7GNbjJ" target="_blank" rel="noopener">
          <img src="CityGuildsLevel3Award.png" class="qualification-badge-img" alt="City &amp; Guilds Level 3 Award Verification Check.">
        </a>
      </div>
    </div>
  </div>
</div>

<!-- SECTION 1: LEGISLATION FUNNEL -->
<section>
  <div class="container">
    <div class="row align-items-center g-5">
      <div class="col-md-6">
        <div class="image-container">
          <img src="/images/Tester.jpg" alt="Calibrated PAT hardware executing asset safety diagnostic traces.">
        </div>
      </div>
      <div class="col-md-6">
        <span class="text-uppercase tracking-wider small fw-bold text-danger" style="color: #ff4a3d !important;">Safety Regulations</span>
        <h2 class="fw-bold text-white mt-1 mb-3">Why Is Testing Essential?</h2>
        <p class="text-muted-dark">
          In-service electrical safety screening is the most direct method to preserve the integrity of your property, your workforce, and insurance coverage. Our testing framework keeps your workplace fully aligned with UK statutory regulations:
        </p>
        <ul class="list-unstyled d-flex flex-column gap-2 text-muted-dark mb-4">
          <li><strong>⚡ HSWA 1974</strong> — General duty of care obligations on structural workplace safety rules.</li>
          <li><strong>⚡ EAWR 1989</strong> — Mandatory systems maintenance to eliminate shock or fire hazards.</li>
          <li><strong>⚡ PUWER 1998</strong> — Suitability screening ensuring industrial gear remains fit for purpose.</li>
        </ul>
        <a href="/pat-info" class="btn btn-outline-custom btn-sm">📖 Read Full Legislation Guidelines</a>
      </div>
    </div>
  </div>
</section>

<!-- SECTION 2: QUALIFICATIONS FUNNEL -->
<section class="bg-alt">
  <div class="container">
    <div class="row align-items-center g-5">
      <div class="col-md-6 order-md-2">
        <div class="image-container">
          <img src="/images/certificate.jpg" alt="Certified electrical inspector vetting site-ready hardware documentation logs.">
        </div>
      </div>
      <div class="col-md-6 order-md-1">
        <span class="text-uppercase tracking-wider small fw-bold text-danger" style="color: #ff4a3d !important;">Professional Trust</span>
        <h2 class="fw-bold text-white mt-1 mb-3">Vetted & Qualified Expertise</h2>
        <p class="text-muted-dark mb-4">
          All equipment diagnostics are executed directly by a fully insured professional holding a City &amp; Guilds Level 3 Award in the In-Service Inspection and Testing of Electrical Equipment, complete with a clean, current Enhanced DBS check.
        </p>
        <div class="row g-2 mb-4 text-white-50 small">
          <div class="col-sm-6">✓ Formal Visual Inspection</div>
          <div class="col-sm-6">✓ Electrical Asset Diagnostics</div>
          <div class="col-sm-6">✓ Compliance Record Keeping</div>
          <div class="col-sm-6">✓ Structural Risk Assessments</div>
        </div>
        <a href="/contact" class="btn btn-outline-custom btn-sm">🎓 View Qualifications &amp; Gear Specs</a>
      </div>
    </div>
  </div>
</section>

<!-- SECTION 3: PROCESS FUNNEL -->
<section>
  <div class="container">
    <div class="row align-items-center g-5">
      <div class="col-md-6">
        <div class="image-container">
          <img src="/images/stickerBackground.jpg" alt="Serialized compliance sticker applied cleanly to an asset pass tag bracket.">
        </div>
      </div>
      <div class="col-md-6">
        <span class="text-uppercase tracking-wider small fw-bold text-danger" style="color: #ff4a3d !important;">Transparent Workflow</span>
        <h2 class="fw-bold text-white mt-1 mb-3">What We Provide For Your Business</h2>
        <p class="text-muted-dark mb-4">
          We perform complete logging, tracking, testing, and labeling workflows using premium Seaward and Metrel analytical rigs. Upon finishing your evaluation, you will be issued a full digital compliance certificate containing complete serial breakdowns of every asset evaluated for your business insurance records.
        </p>
        <a href="/pricing" class="btn btn-red">📊 Calculate Your Estimated Cost Now</a>
      </div>
    </div>
  </div>
</section>

<!-- FLOATING CONTACT BUTTON -->
<div class="contact-fab">
  <a href="/contact" class="text-white d-flex align-items-center justify-content-center" aria-label="Navigate to contact page" title="Contact Us">
    ✉️
  </a>
</div>

<% layout('layouts/boilerplate')%>
    <!-- Body Content -->
    <body>

  <!-- LANDING / HERO SECTION -->
  <div id="movingBackground" class="min-vh-100 d-flex align-items-center position-relative">
    <div class="container">
      <div class="row align-items-center">

        <!-- Image -->
        <div class="col-md-6 text-center">
          <div class="hero-image-wrapper mx-auto">
            <img src="/public/thats me.png" alt="Electrical Testing" class="img-fluid ">
          </div>
        </div>

        <!-- Text -->
        <div class="col-md-6 text-center text-md-start">
          <h1 class="display-5 fw-bold">CamJ Electrical Compliance</h1>
          <h4 class="mt-3">Electrical Equipment Testing</h4>
          <p class="mt-2">Certified Testing by People Who Care</p>
        </div>

      </div>
    </div>

    <!-- Scroll Down Arrow -->
    <div class="scroll-indicator">
      <span class="arrow"></span>
    </div>
  </div>

  <!-- SECTION 1: Image then Text -->
  <section class="py-5">
    <div class="container">
      <div class="row align-items-center gy-4">

        <div class="col-md-6 text-center">
          <img src="image-1.jpg" class="img-fluid rounded shadow" alt="PAT Testing">
        </div>

        <div class="col-md-6">
          <h3>Professional Electrical Testing</h3>
          <p>
            We provide reliable and certified electrical equipment testing to ensure
            safety, compliance, and peace of mind for businesses and individuals.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- SECTION 2: Text then Image (auto stacks on mobile) -->
  <section class="py-5">
    <div class="container">
      <div class="row align-items-center gy-4">

        <div class="col-md-6 order-md-1 order-2">
          <h3>Trusted & Compliant</h3>
          <p>
            Our testing follows the latest standards and regulations, carried out by
            certified professionals who genuinely care about safety.
          </p>
        </div>

        <div class="col-md-6 text-center order-md-2 order-1">
          <img src="image-2.jpg" class="img-fluid rounded shadow" alt="Compliance">
        </div>

      </div>
    </div>
  </section>

<!-- SECTION 3: Image then Text -->
  <section class="py-5">
    <div class="container">
      <div class="row align-items-center gy-4">

        <div class="col-md-6 text-center">
          <img src="image-1.jpg" class="img-fluid rounded shadow" alt="PAT Testing">
        </div>

        <div class="col-md-6">
          <h3>Professional Electrical Testing</h3>
          <p>
            We provide reliable and certified electrical equipment testing to ensure
            safety, compliance, and peace of mind for businesses and individuals.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- CONTACT FORM -->
  <section class="py-5">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-md-8">

          <h2 class="text-center mb-4">Contact Us</h2>

          <form>
            <div class="mb-3">
              <label class="form-label">Name</label>
              <input type="text" class="form-control" required>
            </div>

            <div class="mb-3">
              <label class="form-label">Email</label>
              <input type="email" class="form-control" required>
            </div>

            <div class="mb-3">
              <label class="form-label">Message</label>
              <textarea class="form-control" rows="4" required></textarea>
            </div>

            <div class="text-center">
              <button type="submit" class="btn btn-primary px-4">
                Send Message
              </button>
            </div>
          </form>

        </div>
      </div>
    </div>
  </section>

</body>


<script>
  // Create a new link element
  var link = document.createElement('link');

  // Set the attributes for the link element
  link.rel = 'stylesheet';
  link.type = 'text/css';
  link.href = 'css/homeBackground.css'; // Path to your CSS file

  // Append the link element to the head of the document
  document.head.appendChild(link);
</script>

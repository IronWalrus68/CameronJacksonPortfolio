<% layout('layouts/boilerplate')%>
        <style>
        body {
            background-color: #121212;
            color: #e9ecef;
            scroll-behavior: smooth;
        }

        /* HERO */
        .hero {
            min-height: 90vh;
            background: linear-gradient(135deg, #1c1f24, #0f1115);
            display: flex;
            align-items: center;
            position: relative;
            padding: 5rem 1rem;
        }

        .hero-content {
            max-width: 800px;
        }

        .hero h1 {
            font-size: clamp(3rem, 5vw, 4.5rem);
        }

        .hero p.lead {
            font-size: 1.4rem;
            color: #ced4da;
        }

        /* Qualification badge */
        .qualification-badge {
            position: absolute;
            top: 2rem;
            right: 20rem;
            width: 10rem;
            height: 10rem;
        }

        .qualification-badge img{
            width: 15rem;
            height: 15rem;
        }

@media only screen and (max-width: 1400px) { 
  .qualification-badge { 
    display: none; 
  } 
}


        /* Sections */
        section {
            padding: 4.5rem 1rem;
        }

        .bg-alt {
            background-color: #181b20;
        }

        /* Images */
        .image-container {
    width: 100%;
    height: 320px;
    overflow: hidden;
    border-radius: 0.75rem;
    box-shadow: 0 10px 25px rgba(0,0,0,0.5);
}

.image-container img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}
        /* Floating contact button */
        .contact-fab {
            position: fixed;
            bottom: 24px;
            right: 24px;
            z-index: 1000;
        }

        .contact-fab a {
            width: 64px;
            height: 64px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.6);
        }
    </style>
</head>
<body>

<!-- HERO -->
<div class="hero">
    <div class="qualification-badge">
    <a href="https://digitalcredentials.cityandguilds.com/884ad82f-6216-4f24-b324-4a1b8c1dedd6#acc.cP7GNbjJ"  target="_blank">
        <img src="CityGuildsLevel3Award.png" alt="City Guilds Level 3 Award in the in-service inspection and testing of electrical equipment.">
    </a>
    </div>

    <div class="container">
        <div class="hero-content">
            <h1 class="fw-bold">CamJ PAT Testing</h1>
            <p class="lead mt-4">
                Certified Testing by People Who Care.
            </p>
            <p class="mt-4">
                Helping businesses, landlords, and organisations meet their
                electrical safety obligations with clear reporting and reliable testing.
            </p>
        </div>
    </div>
</div>

<!-- SECTION 1 -->
<section>
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-6 mb-4 mb-md-0">
                <div class="image-container"><img src="/images/Tester.jpg" alt=""></div>
            </div>
            <div class="col-md-6">
                <h2>Why you need PAT / EET? </h2>
                <p>
                    PAT / EET testing and tagging is the easist way to insure the safety of your employees and the public. You will also be complient with the following legislations: 
                </p>
                <p>
                <ul>
                <li><b><a href="https://www.legislation.gov.uk/ukpga/1974/37/introduction"  target="_blank">HSWA 1974</a></b> - This act puts a duty of care upon both the employer and the employees to ensure the safety of all persons using the work premises. (Includes the self-employed)</li>
                <li><b><a href="https://www.legislation.gov.uk/uksi/1998/2306/introduction"  target="_blank">PUWER 1998</a></b> - These Regulations state that "Every employer shall ensure that work equipment is so constructed or adapted as to be suitable for the purpose for which it is used or provided".</li>
                <li><b><a href="https://www.legislation.gov.uk/uksi/1989/635/introduction"  target="_blank">EAWR 1989</a></b> - Employers are required to have electrical systems constructed in a way that prevents danger. Maintain the electrical systems and carry out inspections to insure electrical safety.</li>
                </ul>
                </p>
            </div>
        </div>
    </div>
</section>

<!-- SECTION 2 -->
<section class="bg-alt">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-6 order-md-2 mb-4 mb-md-0">
                <div class="image-container"><img src="/images/certificate.jpg" alt=""></div>
            </div>
            <div class="col-md-6 order-md-1">
                <h2>What makes me qualified</h2>
                <p>
                    I have obtained a <a href="https://digitalcredentials.cityandguilds.com/884ad82f-6216-4f24-b324-4a1b8c1dedd6#acc.l5AoLacH"  target="_blank">"City & Guild Level 3 Award in the In-Service Inspection and Testing of Electrical Equipment"</a>. I have knowledge of the IET Code Of Practice and Electrical Regulations. I am qualified to preform:
                </p>
                <p>
                    <ul>
                      <li>Formal Visual Inspection</li>
                      <li>Health And Safety Inspection</li>
                      <li>Electrical Equipment Inspection</li>
                      <li>Record Keeping</li>
                      <li>Risk Assessments</li>
                      <li>Test Electrical Equipment</li>
                    </ul>
                </p>
            </div>
        </div>
    </div>
</section>

<!-- SECTION 3 -->
<section>
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-6 mb-4 mb-md-0">
                <div class="image-container"><img src="/images/stickerBackground.jpg" alt=""></div>
            </div>
            <div class="col-md-6">
                <h2>What I will do for you</h2>
                <p>
                    I will perform in-service inspection, testing, tagging, and logging of electrical equipment in your place of business. I will carry out a visual inspection, a risk assessment, and, if necessary, an electrical test. The items will then be labelled with a serialised sticker and logged accordingly.
                </p>
                <p>
                    I am constantly working to improve this process and make it as efficient as possible. Once I have finished, you will receive a certificate listing every item that was tested, the results of the tests.
                </p>
                <p>
                  If agreed beforehand, I can also perform basic repairs to defective items I find (such as changing defective fuses, rewiring plugs, and lead shortening).
                </p>
            </div>
        </div>
    </div>
</section>

<!-- CONTACT -->
<section id="contact" class="bg-alt">
    <div class="container text-center">
        <h2 class="mb-4">Contact Information</h2>
        <p>
    <strong>Phone:</strong>
    <a href="#contact"
       onclick="handleContactClick(event)"
       aria-label="Call CamJ Electrical Compliance"
       title="Call us">
        01622 278 135
    </a>
</p>

        <p>
    <strong>Email:</strong>
    <a href="mailto:Contact@camj.uk"
       aria-label="Email CamJ Electrical Compliance"
       title="Email us">
        Contact@CamJ.uk
    </a>
</p>

        <p><strong>Service Area:</strong> Maidstone and Wider Kent Area.</p>
    </div>
</section>

<!-- FLOATING CONTACT BUTTON -->
<div class="contact-fab">
    <a href="#contact"
       class="btn btn-primary"
       onclick="handleContactClick(event)"
       aria-label="Call CamJ Electrical Compliance"
       title="Call us">
        <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" fill="currentColor" class="bi bi-telephone" viewBox="0 0 16 16">
  <path d="M3.654 1.328a.678.678 0 0 0-1.015-.063L1.605 2.3c-.483.484-.661 1.169-.45 1.77a17.6 17.6 0 0 0 4.168 6.608 17.6 17.6 0 0 0 6.608 4.168c.601.211 1.286.033 1.77-.45l1.034-1.034a.678.678 0 0 0-.063-1.015l-2.307-1.794a.68.68 0 0 0-.58-.122l-2.19.547a1.75 1.75 0 0 1-1.657-.459L5.482 8.062a1.75 1.75 0 0 1-.46-1.657l.548-2.19a.68.68 0 0 0-.122-.58zM1.884.511a1.745 1.745 0 0 1 2.612.163L6.29 2.98c.329.423.445.974.315 1.494l-.547 2.19a.68.68 0 0 0 .178.643l2.457 2.457a.68.68 0 0 0 .644.178l2.189-.547a1.75 1.75 0 0 1 1.494.315l2.306 1.794c.829.645.905 1.87.163 2.611l-1.034 1.034c-.74.74-1.846 1.065-2.877.702a18.6 18.6 0 0 1-7.01-4.42 18.6 18.6 0 0 1-4.42-7.009c-.362-1.03-.037-2.137.703-2.877z"/>
</svg>
    </a>
</div>

<script>
function handleContactClick(event) {
    const isMobile = /Mobi|Android|iPhone/i.test(navigator.userAgent);

    if (isMobile) {
        event.preventDefault();
        window.location.href = "tel:+441622278135";
    }
}
</script>

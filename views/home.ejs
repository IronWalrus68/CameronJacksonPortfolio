<% layout('layouts/boilerplate')%>
        <style>
        body {
            background-color: #121212;
            color: #e9ecef;
            scroll-behavior: smooth;
        }

        /* HERO */
        .hero {
            min-height: 90vh;
            background: linear-gradient(135deg, #1c1f24, #0f1115);
            display: flex;
            align-items: center;
            position: relative;
            padding: 5rem 1rem;
        }

        .hero-content {
            max-width: 800px;
        }

        .hero h1 {
            font-size: clamp(3rem, 5vw, 4.5rem);
        }

        .hero p.lead {
            font-size: 1.4rem;
            color: #ced4da;
        }

        /* Qualification badge */
        .qualification-badge {
            position: absolute;
            top: 2rem;
            right: 20rem;
            width: 10rem;
            height: 10rem;
        }

        .qualification-badge img{
            width: 15rem;
            height: 15rem;
        }

@media only screen and (max-width: 1400px) { 
  .qualification-badge { 
    display: none; 
  } 
}


        /* Sections */
        section {
            padding: 4.5rem 1rem;
        }

        .bg-alt {
            background-color: #181b20;
        }

        /* Images */
        .placeholder-img {
            width: 100%;
            height: 260px;
            background: #2a2e35;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #adb5bd;
            font-size: 1.1rem;
            border-radius: 0.75rem;
        }

        /* Floating contact button */
        .contact-fab {
            position: fixed;
            bottom: 24px;
            right: 24px;
            z-index: 1000;
        }

        .contact-fab a {
            width: 64px;
            height: 64px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.6);
        }

        /* Footer */
        footer {
            background: #0d0f12;
            color: #868e96;
            padding: 2.5rem 1rem;
        }
    </style>
</head>
<body>

<!-- HERO -->
<div class="hero">
    <div class="qualification-badge">
    <a href="https://digitalcredentials.cityandguilds.com/884ad82f-6216-4f24-b324-4a1b8c1dedd6#acc.cP7GNbjJ">
        <img src="CityGuildsLevel3Award.png" alt="City Guilds Level 3 Award in the in-service inspection and testing of electrical equipment.">
    </a>
    </div>

    <div class="container">
        <div class="hero-content">
            <h1 class="fw-bold">Your Company Name</h1>
            <p class="lead mt-4">
                Professional PAT Testing & Electrical Compliance
            </p>
            <p class="mt-4">
                Helping businesses, landlords, and organisations meet their
                electrical safety obligations with clear reporting and reliable testing.
            </p>
        </div>
    </div>
</div>

<!-- SECTION 1 -->
<section>
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-6 mb-4 mb-md-0">
                <div class="placeholder-img">Image Placeholder</div>
            </div>
            <div class="col-md-6">
                <h2>Why PAT Testing Matters</h2>
                <p>
                    Placeholder content explaining the importance of portable appliance testing,
                    electrical compliance, and risk reduction.
                </p>
                <p>
                    This section can reference your code of practice and legal responsibilities.
                </p>
            </div>
        </div>
    </div>
</section>

<!-- SECTION 2 -->
<section class="bg-alt">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-6 order-md-2 mb-4 mb-md-0">
                <div class="placeholder-img">Image Placeholder</div>
            </div>
            <div class="col-md-6 order-md-1">
                <h2>Why I’m Qualified</h2>
                <p>
                    Placeholder content outlining your qualifications, training,
                    testing equipment, and calibration standards.
                </p>
                <p>
                    Links to certifications and validation documents can be added here.
                </p>
            </div>
        </div>
    </div>
</section>

<!-- SECTION 3 -->
<section>
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-6 mb-4 mb-md-0">
                <div class="placeholder-img">Image Placeholder</div>
            </div>
            <div class="col-md-6">
                <h2>Additional Information</h2>
                <p>
                    Placeholder section for future content such as services,
                    pricing, FAQs, or customer reassurance.
                </p>
            </div>
        </div>
    </div>
</section>

<!-- CONTACT -->
<section id="contact" class="bg-alt">
    <div class="container text-center">
        <h2 class="mb-4">Contact Information</h2>
        <p><strong>Phone:</strong> 07xxx xxxxxx</p>
        <p><strong>Email:</strong> info@yourcompany.co.uk</p>
        <p><strong>Service Area:</strong> Local & Surrounding Areas</p>
    </div>
</section>

<!-- FLOATING CONTACT BUTTON -->
<div class="contact-fab">
    <a href="#contact" class="btn btn-primary">
        <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" fill="currentColor" class="bi bi-telephone" viewBox="0 0 16 16">
  <path d="M3.654 1.328a.678.678 0 0 0-1.015-.063L1.605 2.3c-.483.484-.661 1.169-.45 1.77a17.6 17.6 0 0 0 4.168 6.608 17.6 17.6 0 0 0 6.608 4.168c.601.211 1.286.033 1.77-.45l1.034-1.034a.678.678 0 0 0-.063-1.015l-2.307-1.794a.68.68 0 0 0-.58-.122l-2.19.547a1.75 1.75 0 0 1-1.657-.459L5.482 8.062a1.75 1.75 0 0 1-.46-1.657l.548-2.19a.68.68 0 0 0-.122-.58zM1.884.511a1.745 1.745 0 0 1 2.612.163L6.29 2.98c.329.423.445.974.315 1.494l-.547 2.19a.68.68 0 0 0 .178.643l2.457 2.457a.68.68 0 0 0 .644.178l2.189-.547a1.75 1.75 0 0 1 1.494.315l2.306 1.794c.829.645.905 1.87.163 2.611l-1.034 1.034c-.74.74-1.846 1.065-2.877.702a18.6 18.6 0 0 1-7.01-4.42 18.6 18.6 0 0 1-4.42-7.009c-.362-1.03-.037-2.137.703-2.877z"/>
</svg>
    </a>
</div>

<!-- FOOTER -->
<footer class="text-center">
    <div class="container">
        <p class="mb-1">© 2026 Your Company Name</p>
        <p class="mb-0">PAT Testing & Electrical Safety Services</p>
    </div>
</footer>
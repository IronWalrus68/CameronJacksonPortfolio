<% layout('layouts/boilerplate')%>
<style>
    body {
      font-family: 'Inter', sans-serif;
      background-color: #0f111a; /* Deep premium dark background */
      color: #e2e8f0; /* Soft off-white text for great readability */
    }
    .hero-pricing {
      background: linear-gradient(135deg, #bd2c1d 0%, #610d05 100%);
      color: white;
      padding: 5rem 0;
      border-radius: 0 0 2rem 2rem;
    }
    .threshold-badge {
      background-color: rgba(255, 255, 255, 0.1);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: 50px;
      display: inline-block;
    }
    .metric-card {
      background-color: #161925;
      color: white;
      border-radius: 1rem;
      border-left: 5px solid #bd2c1d;
      border: 1px solid #222533;
      border-left-width: 5px;
    }
    .pricing-card {
      background: #161925;
      border-radius: 1.25rem;
      border: 1px solid #222533;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .pricing-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 25px rgba(0,0,0,0.3) !important;
      border-color: #31364c;
    }
    .price-tag {
      font-size: 1.75rem;
      font-weight: 700;
      color: #ff4a3d; /* Vibrant glowing red for dark mode contrast */
    }
    .calc-box {
      background-color: #0b0c12;
      border-radius: 1rem;
      border: 1px dashed #31364c;
    }
    .form-control-dark {
      background-color: #0b0c12;
      border: 1px solid #222533;
      color: #fff;
    }
    .form-control-dark:focus {
      background-color: #0b0c12;
      border-color: #ff4a3d;
      color: #fff;
      box-shadow: 0 0 0 0.25rem rgba(255, 74, 61, 0.25);
    }
    .text-muted-dark {
      color: #94a3b8;
    }
    .calc-box .btn:hover {
  background-color: #ff4a3d !important;
  box-shadow: 0 4px 15px rgba(255, 74, 61, 0.4);
}
  </style>
</head>
<body>

<!-- Section: Hero Banner -->
<header class="hero-pricing text-center shadow-sm">
  <div class="container">
    <span class="threshold-badge px-4 py-2 mb-3 fw-semibold text-uppercase tracking-wider small text-white">
      🔒 Minimum Job Order: £50
    </span>
    <h1 class="display-4 fw-bold mb-3">Transparent, Simple Pricing</h1>
    <p class="lead mx-auto text-white-50 style-desc" style="max-width: 600px;">
      Fair testing rates built around your safety. You will not be charged anything until your total test accumulation meets our standard £50 threshold.
    </p>
  </div>
</header>

<main class="container my-5">
  <div class="row g-4">
    
    <!-- Left Column: Explanations & Rates Table -->
    <div class="col-lg-7">
      
      <!-- Metric block: 56p explanation -->
      <div class="metric-card p-4 mb-4 shadow-sm">
        <div class="d-flex align-items-center justify-content-between mb-2">
          <h3 class="h5 fw-bold mb-0">How We Calculate Value</h3>
          <span class="fs-4 fw-bold text-white bg-dark px-3 py-1 rounded-pill" style="border: 1px solid #31364c;">56p*</span>
        </div>
        <p class="small text-muted-dark mb-0">
          <strong>Average Cost Per Test:</strong> Our 56p average is a real-world guide calculated across 56 recent projects and 10,044 individual tests. While every workplace is unique and your final rate will depend on your specific appliance mix, we share this benchmark to help you estimate your budget with confidence.
        </p>
      </div>

      <!-- Main Rate Grid List -->
      <h2 class="h4 fw-bold mb-4 text-white">Standard Rate Tiers</h2>
      <div class="d-flex flex-column gap-3">
        
        <div class="pricing-card p-4 shadow-sm d-flex justify-content-between align-items-center">
          <div>
            <h4 class="h6 fw-bold mb-1 text-white">Visual Only Tests</h4>
            <p class="small text-muted-dark mb-0">Basic visual structural integrity checks</p>
          </div>
          <div class="price-tag">35p</div>
        </div>

        <div class="pricing-card p-4 shadow-sm d-flex justify-content-between align-items-center">
          <div>
            <h4 class="h6 fw-bold mb-1 text-white">Class 1 / Power Lead Tests</h4>
            <p class="small text-muted-dark mb-0">Earthed appliances and mainline power feeds</p>
          </div>
          <div class="price-tag">£1</div>
        </div>

        <div class="pricing-card p-4 shadow-sm d-flex justify-content-between align-items-center">
          <div>
            <h4 class="h6 fw-bold mb-1 text-white">Class 2 Tests / Extension Leads</h4>
            <p class="small text-muted-dark mb-0">Insulated structural casing & power track links</p>
          </div>
          <div class="price-tag">60p</div>
        </div>

        <div class="pricing-card p-4 shadow-sm d-flex justify-content-between align-items-center">
          <div>
            <h4 class="h6 fw-bold mb-1 text-white">Extension Leads</h4>
            <p class="small text-muted-dark mb-0">Insulated structural casing & power track links.</p>
            <p class="small text-muted-dark mb-0">*This test is done for each socket on the extension</p>
          </div>
          <div class="price-tag">60p*</div>
        </div>

        <div class="pricing-card p-4 shadow-sm d-flex justify-content-between align-items-center">
          <div>
            <h4 class="h6 fw-bold mb-1 text-white">Microwave Emissions</h4>
            <p class="small text-muted-dark mb-0">Dedicated radiation leakage testing protocols</p>
          </div>
          <div class="price-tag">£5</div>
        </div>

      </div>
      <p class="text-muted-dark small mt-3">* CamJ Pat Testing reserve the right to apply additional fees for long-distance travel and specialized testing environments, including high-security sites requiring clearance, escorts, or extended safety inductions.</p>
    </div>

    <!-- Right Column: Interactive Estimation Tool -->
    <div class="col-lg-5">
      <div class="card border-0 shadow-sm p-4 sticky-top bg-dark border-secondary" style="top: 2rem; border-radius: 1.25rem; background-color: #161925 !important; border: 1px solid #222533 !important;">
        <h3 class="h5 fw-bold mb-3 text-white">Cost Estimate Calculator</h3>
        <p class="small text-muted-dark mb-4">Input asset quantity targets below to compute variable estimates baseline.</p>
        
        <form id="calcForm">
          <div class="mb-3">
            <label class="form-label small fw-bold text-uppercase text-muted-dark">Visual Only Tests</label>
            <input type="number" class="form-control form-control-dark" id="qtyVisual" value="0" min="0">
          </div>
          <div class="mb-3">
            <label class="form-label small fw-bold text-uppercase text-muted-dark">Class 1 / Power Leads</label>
            <input type="number" class="form-control form-control-dark" id="qtyClass1" value="0" min="0">
          </div>
          <div class="mb-3">
            <label class="form-label small fw-bold text-uppercase text-muted-dark">Class 2 / Extension Leads</label>
            <input type="number" class="form-control form-control-dark" id="qtyClass2" value="0" min="0">
          </div>
          <div class="mb-4">
            <label class="form-label small fw-bold text-uppercase text-muted-dark">Microwave Emissions</label>
            <input type="number" class="form-control form-control-dark" id="qtyMicrowave" value="0" min="0">
          </div>
        </form>

        <div class="calc-box p-3 text-center">
  <span class="small text-muted-dark d-block text-uppercase fw-semibold tracking-wide">Estimated Total</span>
  <div class="display-6 fw-bold my-1 text-white" id="grandTotal">£50.00</div>
  <span id="thresholdStatus" class="badge bg-secondary small mb-3">Minimum Base Rate Applied</span>
  
  <!-- New Booking Button -->
  <a href="booking.html" class="btn w-100 fw-bold py-2 text-white transition" style="background-color: #bd2c1d; border-radius: 0.75rem;">
    📅 Book This Job Now
  </a>
</div>
      </div>
    </div>

  </div>
</main>

<!-- Bootstrap 5 JS & Live Calculation Logic -->
<script src="https://jsdelivr.net"></script>
<script>
  const inputs = ['qtyVisual', 'qtyClass2', 'qtyClass1', 'qtyMicrowave'];
  
  function calculateTotal() {
    const visual = parseInt(document.getElementById('qtyVisual').value) || 0;
    const class2 = parseInt(document.getElementById('qtyClass2').value) || 0;
    const class1 = parseInt(document.getElementById('qtyClass1').value) || 0;
    const micro = parseInt(document.getElementById('qtyMicrowave').value) || 0;
    
    // Exact pricing rules
    let accumulatedPrice = (visual * 0.35) + (class2 * 0.60) + (class1 * 1.00) + (micro * 5.00);
    
    const finalTotal = Math.max(50, accumulatedPrice);
    document.getElementById('grandTotal').innerText = '£' + finalTotal.toFixed(2);
    
    const statusBadge = document.getElementById('thresholdStatus');
    if (accumulatedPrice < 50 && accumulatedPrice > 0) {
      statusBadge.innerText = "Minimum Base Rate Applied";
      statusBadge.className = "badge bg-secondary small mt-1";
    } else if (accumulatedPrice >= 50) {
      statusBadge.innerText = "Threshold Exceeded (Standard Metering)";
      statusBadge.className = "badge bg-success small mt-1";
    } else {
      statusBadge.innerText = "Minimum Base Rate Applied";
      statusBadge.className = "badge bg-secondary small mt-1";
    }
  }

  inputs.forEach(id => {
    document.getElementById(id).addEventListener('input', calculateTotal);
  });
</script>